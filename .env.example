PORT=3000

# MongoDB Atlas connection string (database name: api_monitor)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/api_monitor?retryWrites=true&w=majority

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: only needed if you get "querySrv ECONNREFUSED" on Windows
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Optional tuning
# MAX_BATCH_SIZE=100
# AI_CONCURRENCY=3